// =============================================================================
// matchLog DB Schema (정본)
// - 이 파일이 현재 유효한 스키마 정의다. 변경 이력은 git 로그를 참조.
// - 설계 근거/서비스 책임 노트는 파일 하단 "설계 노트" 블록 참고.
//
// [DB로 강제할 수 없어 서비스 레이어에서 반드시 보장해야 하는 불변식]
//   1) TEAM_ROLE_ASSIGNMENT의 각 역할 participationId는 같은 teamId 소속 PARTICIPATION
//      이어야 함 — 교차 테이블 제약이라 FK로 불가. 서비스에서 검증. (MEMBER_NOT_FOUND)
//      (역할당 1명 제약 자체는 컬럼 구조상 구조적으로 보장됨 — 과거 PARTICIPATION.isCaptain
//      등 boolean 방식은 여러 행이 true일 수 있어 서비스 체크가 필요했으나, FK 컬럼 방식으로
//      전환하며 이 문제는 해소됨)
//   2) VOTE/PLAYER_STAT/LINEUP_SPOT 의 playerId 는 해당 MATCH 의 팀 소속이어야 함 (VOTE는 별도 테이블)
//      — 교차 테이블 제약이라 FK로 불가. 서비스에서 검증. (MEMBER_NOT_FOUND)
//   3) TACTIC/FEEDBACK 의 coachId 는 해당 팀 MANAGER 여야 함 — 서비스에서 검증.
//   4) rating(1~10)/quarter(1~4)/score(>=0)/number(>=0) 범위 — DBML은 CHECK 미표현.
//      MySQL 8.0.16+ CHECK 제약 또는 서비스 검증 권장. (컬럼 note 로 표기)
//   5) MVP_VOTE의 voterId/votedPlayerId는 해당 MATCH의 팀 소속이어야 함, votedPlayerId는
//      해당 MATCH에 PLAYER_STAT row가 존재해야 함(뛴 사람만 후보) — 서비스에서 검증.
//   6) PLAYER_STAT.isMvp는 MVP_VOTE 집계 결과로만 갱신됨(서비스 재계산) — 스탯 저장 API로
//      직접 입력 불가. 경기당 최다득표 전원(동점 포함) true, 득표 0이면 전원 false.
// =============================================================================

// ---------------------------------------------------------------------------
// Enums (값 도메인 고정 — 기존엔 varchar + 주석뿐이라 임의 문자열 저장 가능했음)
// ---------------------------------------------------------------------------
Enum user_provider {
  LOCAL
  GOOGLE
  KAKAO
}

Enum participation_role {
  MANAGER
  PLAYER
}

Enum vote_status {
  ATTEND
  PENDING
  ABSENT
}

Enum match_home_away {
  HOME
  AWAY
}

Enum match_type {
  SOCCER
  FOOTBALL // 풋살
}

Enum preferred_foot {
  LEFT
  RIGHT
}

Enum career {
  AMATEUR        // 순수 아마추어
  MIDDLE_SCHOOL  // 중학교 선수 출신
  HIGH_SCHOOL    // 고등학교 선수 출신
  UNIVERSITY     // 대학교 선수 출신
  ACTIVE         // 현역
}

Enum defensive_line_height {
  HIGH_LINE      // 하이라인
  MID_BLOCK      // 미드블록
  LOW_BLOCK      // 로우블록
}

Enum defensive_spacing {
  COMPACT // 컴팩트
  WIDE    // 넓음
}

Enum set_piece_defense {
  MAN_MARKING  // 전담마크
  ZONE_DEFENSE // 지역방어
}

Enum flank_defense {
  MAN_MARKING  // 전담마크
  ZONE_DEFENSE // 지역방어
}

Enum cross_type {
  EARLY_CROSS     // 얼리크로스 위주
  BOX_ENTRY_CROSS // 페널티 박스 진입 후 크로스 위주
  CUTBACK         // 컷백 위주
}

Enum set_piece_attack {
  SHORT_CORNER  // 숏코너
  DIRECT_SHOT   // 직접 슈팅
  HEADER_TARGET // 헤딩 타겟
}

Enum possession_strategy {
  POSSESSION_FOCUSED // 점유율 중시
  QUICK_COUNTER      // 빠른 역습 중시
  MIXED              // 혼합
}

Enum pressing_trigger {
  FRONT     // 전방
  MIDFIELD  // 중원
  OWN_HALF  // 자진영
}

// ---------------------------------------------------------------------------
// Core
// ---------------------------------------------------------------------------
Table "USER" {
  id bigint [pk, increment]
  email varchar(100) [unique, not null]
  password varchar(255) [null, note: '소셜 로그인 시 null 가능']
  name varchar(50) [not null]
  profileImage varchar(500) [null]
  provider user_provider [not null, default: 'LOCAL', note: '기존 nullable → NOT NULL/기본값 LOCAL 로 강화']
  refreshToken varchar(512) [null, note: '로그인/재발급 시 갱신, 로그아웃 시 null. Redis → DB 관리로 이관']
  createdAt datetime [not null]
  updatedAt datetime [not null]

  Note: 'MySQL 예약어라 JPA @Table 에서 백틱 처리됨(코드 기준). DBML에선 "USER" 로 인용.'
}

Table PLAYER {
  id bigint [pk, increment]
  userId bigint [not null, unique, note: 'USER 와 1:1. 엔티티엔 unique 있었으나 기존 dbml엔 누락 → 동기화']
  birthDate date [null]
  height int [null, note: 'cm']
  weight int [null, note: 'kg']
  preferredFoot preferred_foot [null]
  career career [null]
  yearsOfExperience int [null, note: '구력(년수), 직접 입력']
  preferredPosition varchar(10) [null]
  subPosition varchar(10) [null]
  createdAt datetime [not null]
  updatedAt datetime [not null]
}

Table TEAM {
  id bigint [pk, increment]
  name varchar(100) [not null]
  teamImage varchar(500) [null]
  region varchar(100) [null]
  foundedYear int [null]
  homeGround varchar(200) [null]
  inviteCode varchar(6) [unique, not null, note: '6자리 유니크. 생성 충돌 시 앱에서 재생성 재시도 필요']
  createdAt datetime [not null]
  updatedAt datetime [not null]
}

Table PARTICIPATION {
  id bigint [pk, increment]
  playerId bigint [not null]
  teamId bigint [not null]
  role participation_role [not null]
  number int [null, note: '>= 0 권장(CHECK)']
  mainPosition varchar(10) [null]
  subPosition varchar(10) [null]
  joinedAt datetime [not null]
  updatedAt datetime [not null]

  indexes {
    (teamId, playerId) [unique, name: 'uk_participation_team_player'] // 중복 팀 가입 방지 (ALREADY_JOINED)
    (teamId, role)     [name: 'idx_participation_team_role']          // countByTeamIdAndRole
    (playerId)         [name: 'idx_participation_player']             // countByPlayerId
  }

  Note: '테이블명 PARTICIPATIONS(복수) → PARTICIPATION(단수)로 통일. 엔티티 @Table 후속 수정 필요. 세트피스 전담 역할(주장/PK키커/CK/FK)은 boolean 6컬럼 방식에서 TEAM_ROLE_ASSIGNMENT 테이블(FK 참조 방식)로 이전됨.'
}

Table TEAM_ROLE_ASSIGNMENT {
  id bigint [pk, increment]
  teamId bigint [not null, unique, note: 'TEAM과 1:1']
  captainParticipationId bigint [null, note: '주장. 빈 슬롯은 NULL']
  pkTakerParticipationId bigint [null, note: 'PK 키커. 빈 슬롯은 NULL']
  ckLeftParticipationId bigint [null, note: 'CK 왼쪽 키커. 빈 슬롯은 NULL']
  ckRightParticipationId bigint [null, note: 'CK 오른쪽 키커. 빈 슬롯은 NULL']
  fkLeftParticipationId bigint [null, note: 'FK 왼쪽 키커. 빈 슬롯은 NULL']
  fkRightParticipationId bigint [null, note: 'FK 오른쪽 키커. 빈 슬롯은 NULL']
  createdAt datetime [not null]
  updatedAt datetime [not null]

  Note: '팀 생성 시 즉시 1행 생성(모든 역할 NULL) — "row 없음" 예외 분기를 서비스 코드에 퍼뜨리지 않기 위함. 역할당 1명 제약은 컬럼이 단일 값이라 구조적으로 보장됨(과거 PARTICIPATION.isCaptain 등 boolean 방식 대체).'
}

// ---------------------------------------------------------------------------
// Match & 참여 기록
// ---------------------------------------------------------------------------
Table "MATCH" {
  id bigint [pk, increment]
  teamId bigint [not null]
  opponent varchar(100) [not null, note: '상대가 matchLog 사용 시 팀ID 연동은 향후 과제']
  matchDate datetime [not null]
  location varchar(200) [null]
  homeAway match_home_away [not null]
  matchType match_type [not null]
  scoreHome int [null, note: '>= 0 권장(CHECK)']
  scoreAway int [null, note: '>= 0 권장(CHECK)']
  isFinished boolean [not null, default: false]
  createdAt datetime [not null]
  updatedAt datetime [not null]

  indexes {
    (teamId, matchDate) [unique, name: 'uk_match_team_date'] // 동일 팀·동일 일시 중복 경기 방지 (MATCH_ALREADY_EXISTS)
  }

  Note: 'MySQL 예약어라 JPA @Table 에서 백틱 처리됨(코드 기준). DBML에선 "MATCH" 로 인용.'
}

Table VOTE {
  id bigint [pk, increment]
  matchId bigint [not null]
  playerId bigint [not null]
  status vote_status [not null]
  votedAt datetime [not null]

  indexes {
    (matchId, playerId) [unique, name: 'uk_vote_match_player'] // 중복 투표 방지 (ALREADY_VOTED)
    (matchId, status)   [name: 'idx_vote_match_status']        // 상태별 집계(참석/보류/불참)
  }
}

Table LINEUP {
  id bigint [pk, increment]
  matchId bigint [not null]
  quarter int [not null, note: '1~4 (CHECK 권장)']
  formation varchar(20) [not null, note: '4-2-3-1 / 4-3-3 등']
  createdAt datetime [not null]
  updatedAt datetime [not null]

  indexes {
    (matchId, quarter) [unique, name: 'uk_lineup_match_quarter'] // 쿼터당 라인업 1개
  }
}

Table MATCH_GUEST {
  id        bigint      [pk, increment]
  matchId   bigint      [not null]
  name      varchar(50) [not null]
  position  varchar(10) [null, note: '주 포지션 (선택)']
  createdAt datetime    [not null]
}

Table LINEUP_SPOT {
  id bigint [pk, increment]
  lineupId bigint [not null]
  playerId bigint [null,  note: '팀 선수 — guestId와 둘 중 하나만 non-null (서비스 검증)']
  guestId  bigint [null,  note: '용병 — playerId와 둘 중 하나만 non-null (서비스 검증)']
  position varchar(10) [not null, note: 'GK / LB / CB / RB 등']
  isStarter boolean [not null, note: 'true: 선발 / false: 후보']

  indexes {
    (lineupId, playerId) [unique, name: 'uk_lineup_spot_lineup_player'] // 팀 선수 중복 배치 방지 (NULL은 MySQL에서 중복 허용)
    (lineupId, guestId)  [unique, name: 'uk_lineup_spot_lineup_guest']  // 용병 중복 배치 방지
  }

  Note: '동일 라인업 내 선발 포지션 중복(DUPLICATE_POSITION_IN_LINEUP)은 isStarter 조건부라 DB 제약 불가 → 서비스 검증.'
}

Table PLAYER_STAT {
  id bigint [pk, increment]
  matchId bigint [not null]
  playerId bigint [not null]
  goals int [not null, default: 0]
  assists int [not null, default: 0]
  shots int [not null, default: 0]
  saves int [null, note: 'GK 전용']
  goalsConceded int [null, note: 'GK 전용']
  cleanSheet boolean [null, note: 'GK 전용']
  isMvp boolean [not null, default: false, note: 'MVP_VOTE 집계 결과로만 갱신. 스탯 저장 API로 직접 입력 불가']
  createdAt datetime [not null]
  updatedAt datetime [not null]

  indexes {
    (matchId, playerId) [unique, name: 'uk_player_stat_match_player'] // 선수·경기당 스탯 1행
  }
}

Table MVP_VOTE {
  id bigint [pk, increment]
  matchId bigint [not null]
  voterId bigint [not null, note: '투표한 선수. Player.id, 본인 투표 허용']
  votedPlayerId bigint [not null, note: 'MVP로 지명된 선수. Player.id']
  votedAt datetime [not null]

  indexes {
    (matchId, voterId) [unique, name: 'uk_mvp_vote_match_voter'] // 경기당 1인 1표 (재투표는 update)
  }
}

// ---------------------------------------------------------------------------
// 전술 / 피드백 (팀 = 경기당 1개, 개인 = 경기+선수당 1개)
// ---------------------------------------------------------------------------
// 수정된 TEAM_TACTIC 테이블
Table TEAM_TACTIC {
  id bigint [pk, increment]
  matchId bigint [not null]
  coachId bigint [null, note: 'Player.id(팀 MANAGER, 서비스 검증). 작성 코치 탈퇴 시에도 전술 내용 보존 위해 nullable + ON DELETE SET NULL(작성자 미표시)']

  // 기존
  content text [null, note: '자유 코멘트. 전술 항목 추가로 nullable로 변경']

  // 수비
  defensiveLineHeight defensive_line_height [null, note: '수비 라인 높이']
  defensiveSpacing    defensive_spacing     [null, note: '수비 간격']
  setPieceDefense     set_piece_defense     [null, note: '세트피스 수비 방식']
  flankDefense        flank_defense         [null, note: '측면 수비 대응']
  offsideTrap         boolean               [null, note: '오프사이드 트랩 활용 여부']

  // 공격
  crossType           cross_type            [null, note: '크로스 시도 위치']
  setPieceAttack      set_piece_attack      [null, note: '세트피스 공격 패턴']

  // 중원
  possessionStrategy  possession_strategy   [null, note: '볼 소유 전략']

  // 공통
  pressingTrigger     pressing_trigger      [null, note: '압박 시작 지점']
  pressingIntensity   int                   [null, note: '압박 강도 1~5 (CHECK 권장)']

  createdAt datetime [not null]
  updatedAt datetime [not null]

  indexes {
    (matchId) [unique, name: 'uk_team_tactic_match'] // 경기당 팀 전술 1개
  }
}

Table PERSONAL_TACTIC {
  id bigint [pk, increment]
  matchId bigint [not null]
  playerId bigint [not null, note: '대상 선수']
  coachId bigint [null, note: '작성자(팀 MANAGER, 서비스 검증). 작성 코치 탈퇴 시에도 전술 내용 보존 위해 nullable + ON DELETE SET NULL(작성자 미표시)']
  content text [not null]
  createdAt datetime [not null]
  updatedAt datetime [not null]

  indexes {
    (matchId, playerId) [unique, name: 'uk_personal_tactic_match_player'] // 경기+선수당 개인 전술 1개
  }
}

Table TEAM_FEEDBACK {
  id bigint [pk, increment]
  matchId bigint [not null]
  coachId bigint [null, note: 'Player.id(팀 MANAGER, 서비스 검증). 작성 코치 탈퇴 시에도 피드백 내용 보존 위해 nullable + ON DELETE SET NULL(작성자 미표시)']
  content text [not null]
  createdAt datetime [not null]
  updatedAt datetime [not null]

  indexes {
    (matchId) [unique, name: 'uk_team_feedback_match'] // 경기당 팀 피드백 1개
  }
}

Table PERSONAL_FEEDBACK {
  id bigint [pk, increment]
  matchId bigint [not null]
  playerId bigint [not null, note: '대상 선수']
  coachId bigint [null, note: '작성자(팀 MANAGER, 서비스 검증). 작성 코치 탈퇴 시에도 피드백 내용 보존 위해 nullable + ON DELETE SET NULL(작성자 미표시)']
  content text [null]
  rating int [null, note: '1~10 (CHECK 권장)']
  pros text [null]
  cons text [null]
  tags varchar(500) [null, note: 'JSON 배열 문자열. MySQL JSON 타입 승격 고려(H2 테스트와 동작 차이 주의)']
  isVisible boolean [not null, default: true]
  createdAt datetime [not null]
  updatedAt datetime [not null]

  indexes {
    (matchId, playerId) [unique, name: 'uk_personal_feedback_match_player'] // 경기+선수당 개인 피드백 1개
  }
}

// ---------------------------------------------------------------------------
// Document
// ---------------------------------------------------------------------------
Table DOCUMENT {
  id bigint [pk, increment]
  teamId bigint [not null]
  playerId bigint [not null, note: '작성자']
  matchId bigint [null, note: '경기 연결 게시글(후기 등). 경기 삭제 시 게시글 보존 위해 ON DELETE SET NULL']
  isPinned boolean [not null, default: false, note: '상단 고정 여부. MANAGER만 제어 가능']
  title varchar(200) [not null]
  content text [not null]
  createdAt datetime [not null]
  updatedAt datetime [not null]

  indexes {
    (teamId)          [name: 'idx_document_team']       // 팀 게시글 목록
    (teamId, matchId) [name: 'idx_document_team_match'] // 경기 연결 게시글 조회
  }
}

// ---------------------------------------------------------------------------
// Relationships (ON DELETE CASCADE — 하드 삭제 정책)
//   부모 삭제 시 자식 기록도 함께 삭제. 회원 탈퇴/팀 삭제/경기 삭제 시나리오와 일치.
//   ※ 정책 변경(soft delete 등) 시 여기 delete 액션만 조정.
// ---------------------------------------------------------------------------
Ref: PLAYER.userId > "USER".id [delete: cascade]

Ref: PARTICIPATION.playerId > PLAYER.id [delete: cascade]
Ref: PARTICIPATION.teamId > TEAM.id [delete: cascade]

Ref: TEAM_ROLE_ASSIGNMENT.teamId > TEAM.id [delete: cascade]
Ref: TEAM_ROLE_ASSIGNMENT.captainParticipationId > PARTICIPATION.id [delete: set null] // 선수가 팀을 나가도 배정 자체는 유지, 슬롯만 비움
Ref: TEAM_ROLE_ASSIGNMENT.pkTakerParticipationId > PARTICIPATION.id [delete: set null]
Ref: TEAM_ROLE_ASSIGNMENT.ckLeftParticipationId > PARTICIPATION.id [delete: set null]
Ref: TEAM_ROLE_ASSIGNMENT.ckRightParticipationId > PARTICIPATION.id [delete: set null]
Ref: TEAM_ROLE_ASSIGNMENT.fkLeftParticipationId > PARTICIPATION.id [delete: set null]
Ref: TEAM_ROLE_ASSIGNMENT.fkRightParticipationId > PARTICIPATION.id [delete: set null]

Ref: "MATCH".teamId > TEAM.id [delete: cascade]

Ref: VOTE.matchId > "MATCH".id [delete: cascade]
Ref: VOTE.playerId > PLAYER.id [delete: cascade]

Ref: LINEUP.matchId > "MATCH".id [delete: cascade]
Ref: MATCH_GUEST.matchId > "MATCH".id [delete: cascade]

Ref: LINEUP_SPOT.lineupId > LINEUP.id [delete: cascade]
Ref: LINEUP_SPOT.playerId > PLAYER.id [delete: cascade]
Ref: LINEUP_SPOT.guestId > MATCH_GUEST.id [delete: cascade]

Ref: PLAYER_STAT.matchId > "MATCH".id [delete: cascade]
Ref: PLAYER_STAT.playerId > PLAYER.id [delete: cascade]

Ref: MVP_VOTE.matchId > "MATCH".id [delete: cascade]
Ref: MVP_VOTE.voterId > PLAYER.id [delete: cascade]
Ref: MVP_VOTE.votedPlayerId > PLAYER.id [delete: cascade]

Ref: TEAM_TACTIC.matchId > "MATCH".id [delete: cascade]
Ref: TEAM_TACTIC.coachId > PLAYER.id [delete: set null] // 작성 코치 삭제돼도 전술 내용 보존

Ref: PERSONAL_TACTIC.matchId > "MATCH".id [delete: cascade]
Ref: PERSONAL_TACTIC.playerId > PLAYER.id [delete: cascade]
Ref: PERSONAL_TACTIC.coachId > PLAYER.id [delete: set null] // 작성 코치 삭제돼도 전술 내용 보존

Ref: TEAM_FEEDBACK.matchId > "MATCH".id [delete: cascade]
Ref: TEAM_FEEDBACK.coachId > PLAYER.id [delete: set null] // 작성 코치 삭제돼도 피드백 내용 보존

Ref: PERSONAL_FEEDBACK.matchId > "MATCH".id [delete: cascade]
Ref: PERSONAL_FEEDBACK.playerId > PLAYER.id [delete: cascade]
Ref: PERSONAL_FEEDBACK.coachId > PLAYER.id [delete: set null] // 작성 코치 삭제돼도 피드백 내용 보존

Ref: DOCUMENT.teamId > TEAM.id [delete: cascade]
Ref: DOCUMENT.playerId > PLAYER.id [delete: cascade]
Ref: DOCUMENT.matchId > "MATCH".id [delete: set null] // 경기 삭제 시 게시글 보존

// ---------------------------------------------------------------------------
// 설계 노트 (정합성 관련 핵심 결정)
//   - 유니크 제약으로 중복 방지: PARTICIPATION(team,player), VOTE(match,player),
//     PLAYER_STAT(match,player), MVP_VOTE(match,voter), LINEUP(match,quarter),
//     LINEUP_SPOT(lineup,player), MATCH(team,matchDate), TEAM/PERSONAL_FEEDBACK·TACTIC,
//     TEAM_ROLE_ASSIGNMENT(teamId).
//   - DOCUMENT는 NOTE 전용. VOTE는 별도 VOTE 테이블에서 독립 관리.
//   - 값 도메인은 Enum으로 고정(varchar 임의 문자열 방지). 범위값(rating/quarter/score
//     /number)은 DBML CHECK 미표현 → MySQL CHECK 또는 서비스 검증 권장(컬럼 note).
//   - 삭제 정책: 기본 ON DELETE CASCADE. 단 "작성자/연결"만 끊고 기록은 보존해야 하는
//     곳은 ON DELETE SET NULL — TACTIC/FEEDBACK.coachId(작성 코치 탈퇴), DOCUMENT.matchId
//     (경기 삭제 시 게시글 보존), TEAM_ROLE_ASSIGNMENT의 6개 participationId(선수 탈퇴 시
//     배정 자체는 보존하고 슬롯만 비움).
//
// [DB 스키마와 별개로 후속 반영 필요 — 코드 측]
//   - 엔티티: @Table(uniqueConstraints=...), Participation 테이블명 단수화,
//     User.provider nullable=false+default, Document.isPinned 리네임,
//     TACTIC/FEEDBACK.coachId nullable 반영.
//   - 실제 DDL/마이그레이션 스크립트(ALTER TABLE ... ADD UNIQUE / FK ON DELETE 액션).
// ---------------------------------------------------------------------------
